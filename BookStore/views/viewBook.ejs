<%- include('partials/header') %>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">All Books</h2>
        <a href="/add" class="btn btn-primary">Add New Book</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Cover</th>
                        <th>Title</th>
                        <th>Price</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% books.forEach(book => { %>
                        <tr>
                            <td class="ps-4">
                                <img src="/uploads/<%= book.image %>" class="rounded" style="width: 50px; height: 70px; object-fit: cover;">
                            </td>
                            <td>
                                <div class="fw-bold"><%= book.title %></div>
                                <div class="text-muted small"><%= book.author %></div>
                            </td>
                            <td>₹<%= book.price %></td>
                            <td class="text-center">
                                <a href="/edit/<%= book._id %>" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form action="/delete/<%= book._id %>" method="POST" class="d-inline" onsubmit="return confirm('Sure?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>